@model _25DH110847_MyStore.Models.Order
@using System.Linq

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mt-4 mb-3">CHI TIẾT ĐƠN HÀNG</h2>

<div class="row">
    <section class="col-md-4 mb-4">
        <h5 class="text-uppercase text-center">Thông tin đơn hàng</h5>
        <dl class="row">
            <dt class="col-sm-6 text-sm-end">Ngày đặt hàng</dt>
            <dd class="col-sm-6">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-6 text-sm-end">Tên khách hàng</dt>
            <dd class="col-sm-6">@(Model.Customer == null ? "(Không có thông tin)" : Model.Customer.CustomerName)</dd>

            <dt class="col-sm-6 text-sm-end">Tổng giá trị</dt>
            <dd class="col-sm-6">@Model.TotalAmount.ToString("N0")</dd>

            <dt class="col-sm-6 text-sm-end">Phương thức thanh toán</dt>
            <dd class="col-sm-6">@Model.PaymentMethod</dd>

            <dt class="col-sm-6 text-sm-end">Trạng thái thanh toán</dt>
            <dd class="col-sm-6">@Model.PaymentStatus</dd>

            <dt class="col-sm-6 text-sm-end">Trạng thái đơn hàng</dt>
            <dd class="col-sm-6">@Model.OrderStatus</dd>

            <dt class="col-sm-6 text-sm-end">Phương thức giao hàng</dt>
            <dd class="col-sm-6">@Model.DeliveryMethod</dd>

            <dt class="col-sm-6 text-sm-end">Địa chỉ giao hàng</dt>
            <dd class="col-sm-6">@Model.ShippingAddress</dd>
        </dl>
    </section>

    <section class="col-md-8">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (item.Product != null && !string.IsNullOrWhiteSpace(item.Product.ProductImage))
                                        {
                                            <img src="@Url.Content(item.Product.ProductImage)"
                                                 alt="@item.Product.ProductName"
                                                 style="width: 90px; height: 125px; object-fit: contain;" />
                                        }
                                        <span>@(item.Product == null ? "Sản phẩm đã xóa" : item.Product.ProductName)</span>
                                    </div>
                                </td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                                <td class="text-end">@((item.TotalPrice ?? item.UnitPrice * item.Quantity).ToString("N0"))</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted">Đơn hàng chưa có sản phẩm.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="mt-3">
    @Html.ActionLink("Cập nhật trạng thái", "EditStatus", new { id = Model.OrderID }, new { @class = "btn btn-primary me-2" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
</div>
